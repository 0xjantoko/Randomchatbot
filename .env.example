# Telegram Bot Token
# Get from @BotFather
BOT_TOKEN=your_bot_token_here

# Database path
DB_PATH=./data.db

# Age limits (minimum 18)
MIN_AGE=18
MAX_AGE=99

# Max wait time in seconds
MAX_WAIT_TIME=300

# Session timeout in seconds
SESSION_TIMEOUT=3600

# Telegram Star Prices (in stars)
STAR_PRICE_18=50
STAR_PRICE_SAME=30