# Telegram Bot Token
# Get from @BotFather
BOT_TOKEN=your_bot_token_here

# Database path
DB_PATH=./data.db

# Age limits (13-17 = Pool Minor, 18+ = Pool Adult; dipakai gate onboarding)
MIN_AGE=13
MAX_AGE=99

# Moderation & retention (opsional)
# Pool Minor: partner sama tidak boleh di-match ulang dalam N jam
MINOR_REMATCH_HOURS=24
# Bukti terenkripsi (transcript breach / sesi Pool Minor) disimpan N hari
EVIDENCE_TTL_DAYS=30
EVIDENCE_MAX_MESSAGES=20

# Max wait time in seconds
MAX_WAIT_TIME=300

# Session timeout in seconds
SESSION_TIMEOUT=3600

# --- SECURITY (wajib diisi) ---
# SHA-256 salt untuk anonymize user ID
HASH_SECRET=your-random-hex-string-here
# API Key untuk admin panel
ADMIN_API_KEY=your-random-api-key-here
# AES-256-GCM key untuk encrypted logs (32 bytes hex)
LOG_ENCRYPTION_KEY=your-64-char-hex-key-here-min-64-chars-of-hex